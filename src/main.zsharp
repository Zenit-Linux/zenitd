    func memcpy(int $d, string $s, int $n): int;
    func memcmp(int $a, int $b, int $n): int;
    func strstr(int $h, string $n): string;
    func strdup(string $s): int;
    func strerror(int $e): string;
    func __errno_location(): int;

    # procesy i sygnały
    func fork(): int;
    func _exit(int $c): int;
    func waitpid(int $pid, int $st, int $opt): int;
    func kill(int $pid, int $sig): int;
