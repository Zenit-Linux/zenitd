import Workspace.sys;
import Workspace.util;
import Workspace.ini;
import Workspace.unit;
import Workspace.config;
import Workspace.execspec;
func eq($name, $got, $want) {
    if ($got == $want) { echo "ok   " . $name; return 0; }
    echo "FAIL " . $name . " got=" . strval($got) . " want=" . strval($want);
    return 1;
}
$f = 0;
$s = new Sys();
$s->addFile("/etc/default/app", "# c\nFOO=\"bar baz\"\nN=1\n");
$s->addFile("/usr/bin/app", "x");
$cfg = config.load($s, "system", ["HOME" => "/root"]);
$txt = "[Service]\nExecStart=/usr/bin/app --x\nUser=www\nEnvironment=A=1 \"B=two words\"\nEnvironmentFile=/etc/default/app\nEnvironmentFile=-/nope\nWorkingDirectory=~\nUMask=0027\nLimitNOFILE=1024:4096\nLimitCORE=infinity\nNoNewPrivileges=yes\nPrivateTmp=true\nProtectSystem=full\nReadWritePaths=-/var/lib/app\nCapabilityBoundingSet=~CAP_SYS_ADMIN\nAmbientCapabilities=CAP_NET_BIND_SERVICE\nStandardOutput=journal\nPrivateDevices=yes\n";
$u = unit.build("app.service", ini.parse($txt)["sections"], "/x", []);
$cmd = util.parseExec("/usr/bin/app --x", []);
$r = execspec.build($s, $cfg, $u, $cmd, ["cgroup" => "/sys/fs/cgroup/zenit.slice/app.service", "outFd" => 7, "notifySock" => "/run/zenit/notify/app.service", "isMain" => true]);
$sp = $r["spec"];
$f += eq("no error", $r["error"], "");
$f += eq("uid", $sp["uid"], 33);
$f += eq("gid", $sp["gid"], 33);
$f += eq("path", $sp["path"], "/usr/bin/app");
$f += eq("dir ~", $sp["dir"], "/var/www");
$f += eq("umask", $sp["umask"], 23);
$f += eq("env B", util.contains_item($sp["env"], "B=two words"), true);
$f += eq("env file", util.contains_item($sp["env"], "FOO=bar baz"), true);
$f += eq("env HOME", util.contains_item($sp["env"], "HOME=/var/www"), true);
$f += eq("env notify", util.contains_item($sp["env"], "NOTIFY_SOCKET=/run/zenit/notify/app.service"), true);
$f += eq("limits", count($sp["limits"]), 2);
$f += eq("limit nofile", join($sp["limits"][0], ":"), "NOFILE:1024:4096");
$f += eq("limit core inf", join($sp["limits"][1], ":"), "CORE:inf:inf");
$f += eq("stdout", $sp["stdout"], "fd:7");
$f += eq("stderr follows", $sp["stderr"], "fd:7");
$f += eq("stdin null", $sp["stdin"], "null");
$f += eq("sandbox nnp", $sp["sandbox"]["nnp"], true);
$f += eq("sandbox psys", $sp["sandbox"]["psys"], "full");
$f += eq("sandbox rw stripped", $sp["sandbox"]["rw"][0], "/var/lib/app");
$f += eq("bounding black", join($sp["bounding"], ","), "~,CAP_SYS_ADMIN");
$f += eq("ambient", $sp["ambient"][0], "CAP_NET_BIND_SERVICE");
$f += eq("cgroup", $sp["cgroup"], "/sys/fs/cgroup/zenit.slice/app.service");
$f += eq("ignored", count($r["ignored"]), 1);
$u2 = unit.build("b.service", ini.parse("[Service]\nUser=ghost\nExecStart=/bin/x\n")["sections"], "/x", []);
$r2 = execspec.build($s, $cfg, $u2, util.parseExec("/bin/x", []), []);
$f += eq("missing user error", $r2["spec"], null);
$u3 = unit.build("c.service", ini.parse("[Service]\nExecStart=/bin/x\n")["sections"], "/x", []);
$r3 = execspec.build($s, $cfg, $u3, util.parseExec("/bin/x", []), ["fds" => [11, 12], "fdNames" => ["a", "b"]]);
$f += eq("listen env", util.contains_item($r3["spec"]["env"], "LISTEN_FDS=2"), true);
$f += eq("listen slot >= 0", $r3["spec"]["listenPidSlot"] >= 0, true);
$f += eq("dirs", count(execspec.prepareDirs($s, $cfg, unit.build("d.service", ini.parse("[Service]\nRuntimeDirectory=d\nStateDirectory=d\n")["sections"], "/x", []), 5, 5)), 1);
$f += eq("state dir made", $s->isDir("/var/lib/d"), true);
exit($f);
