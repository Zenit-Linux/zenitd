namespace socket;
import Workspace.util;
import Workspace.runtime;

class Socket extends Runtime {
    public $fds = [];
    public $names = [];
    public $paths = [];
    public $triggered = false;
    public $failMsg = "";
    public $kinds = [];

    # nazwa usługi aktywowanej przez to gniazdo
    public func serviceName() {
        $s = $this->unit->get("Socket", "Service", "");
        if ($s != "") { return $s; }
        return util.unitStem($this->name()) . ".service";
    }

    func parseListen($v) {
        if (starts_with($v, "/") || starts_with($v, "@")) { return ["unix", $v, 0]; }
        $host = "";
        $port = 0;
        if (starts_with($v, "[")) {
            $e = index_of($v, "]");
            if ($e < 0) { return null; }
            $host = substr($v, 1, $e - 1);
            $port = util.parseInt(substr($v, $e + 2, strlen($v) - $e - 2), -1);
        } else {
            $c = index_of($v, ":");
            if ($c >= 0) {
                $host = substr($v, 0, $c);
                $port = util.parseInt(substr($v, $c + 1, strlen($v) - $c - 1), -1);
            } else { $port = util.parseInt($v, -1); }
        }
        if ($port < 0 || $port > 65535) { return null; }
        return ["tcp", $host, $port];
    }

    public func start($mgr) {
        if ($this->state == "active") { return 0; }
        if ($this->unit->getBool("Socket", "Accept", false)) {
            $this->failMsg = "Accept=yes nie jest obsługiwane (użyj Accept=no i aktywacji z fd)";
            $this->result = "resources";
            $mgr->log(3, $this->name(), $this->failMsg);
            $this->setState($mgr, "failed", "failed");
            return 0;
        }
        $mode = 438;
        $mv = $this->unit->get("Socket", "SocketMode", "");
        if ($mv != "") { $mode = $this->octal($mv); }
        $backlog = $this->unit->getInt("Socket", "Backlog", 128);
        $this->fds = [];
        $this->names = [];
        $this->paths = [];
        $this->kinds = [];
        $fdName = $this->unit->get("Socket", "FileDescriptorName", util.unitStem($this->name()));
        foreach (["ListenStream", "ListenDatagram"] as $key) {
            foreach ($this->unit->getAll("Socket", $key) as $v) {
                $l = $this->parseListen($v);
                if ($l == null) { $this->fail($mgr, "Niepoprawny adres " . $key . "=" . $v); return 0; }
                $fd = -1;
                if ($l[0] == "unix") {
                    $dm = $this->unit->get("Socket", "DirectoryMode", "");
                    if (!starts_with($l[1], "@")) { $mgr->sys->mkdirp(util.dirname($l[1]), $dm != "" ? $this->octal($dm) : 493); }
                    if ($key == "ListenStream") { $fd = $mgr->sys->listenUnix($l[1], $mode, $backlog); }
                    else { $fd = $mgr->sys->bindDgram($l[1], $mode); }
                    if ($fd >= 0 && !starts_with($l[1], "@")) {
                        $this->paths[] = $l[1];
                        $this->chownSocket($mgr, $l[1]);
                    }
                } else {
                    if ($key == "ListenDatagram") { $this->fail($mgr, "ListenDatagram po UDP nie jest obsługiwane"); return 0; }
                    $fd = $mgr->sys->listenTcp($l[1], $l[2], $backlog);
                }
                if ($fd < 0) { $this->fail($mgr, "Nie można nasłuchiwać na " . $v . ": " . $mgr->sys->errstr($fd)); return 0; }
                $this->fds[] = $fd;
                $this->names[] = $fdName;
                $this->kinds[] = $key;
            }
        }
        if (count($this->fds) == 0) { $this->fail($mgr, "Brak Listen*= w jednostce socket"); return 0; }
        $this->triggered = false;
        foreach ($this->fds as $fd) { $mgr->watch($fd, "sock", $this->name()); }
        $this->setState($mgr, "active", "listening");
        return 0;
    }

    func octal($s) {
        $v = 0;
        foreach (chars(trim($s)) as $c) { if (is_digit($c)) { $v = $v * 8 + intval($c); } }
        return $v;
    }

    func chownSocket($mgr, $path) {
        $u = $this->unit->get("Socket", "SocketUser", "");
        $g = $this->unit->get("Socket", "SocketGroup", "");
        if ($u == "" && $g == "") { return 0; }
        $uid = -1;
        $gid = -1;
        if ($u != "") { $uid = $mgr->sys->userUid($u); }
        if ($g != "") { $gid = $mgr->sys->groupGid($g); }
        $mgr->sys->chown($path, $uid, $gid);
        return 0;
    }

    func fail($mgr, $msg) {
        $this->failMsg = $msg;
        $this->result = "resources";
        $mgr->log(3, $this->name(), $msg);
        $this->closeAll($mgr);
        $this->setState($mgr, "failed", "failed");
        return 0;
    }

    func closeAll($mgr) {
        foreach ($this->fds as $fd) {
            $mgr->unwatch($fd);
            $mgr->sys->close($fd);
        }
        foreach ($this->paths as $p) { $mgr->sys->unlink($p); }
        $this->fds = [];
        $this->paths = [];
        return 0;
    }

    public func stop($mgr) {
        if ($this->state == "inactive" || $this->state == "failed") { return 0; }
        $this->closeAll($mgr);
        $this->setState($mgr, "inactive", "dead");
        return 0;
    }

    # połączenie przyszło: odłącz nasłuch (usługa przejmuje fd) i poproś menedżera o start usługi
    public func onFd($mgr, $fd, $flags, $kind) {
        if ($this->triggered || $this->state != "active") { return 0; }
        $this->triggered = true;
        foreach ($this->fds as $f) { $mgr->unwatch($f); }
        $mgr->enqueueStart($this->serviceName(), "aktywacja gniazda " . $this->name());
        return 0;
    }

    # usługa skończyła pracę — nasłuchuj ponownie
    public func resume($mgr) {
        if (!$this->triggered || $this->state != "active") { return 0; }
        $this->triggered = false;
        foreach ($this->fds as $f) { $mgr->watch($f, "sock", $this->name()); }
        return 0;
    }

    public func describe($mgr) {
        $l = [];
        foreach ($this->unit->getAll("Socket", "ListenStream") as $v) { $l[] = [$v, "Stream"]; }
        foreach ($this->unit->getAll("Socket", "ListenDatagram") as $v) { $l[] = [$v, "Datagram"]; }
        return ["listen" => $l, "service" => $this->serviceName(), "failMsg" => $this->failMsg, "triggered" => $this->triggered];
    }
}
