namespace cgroup;
import Workspace.util;

class Cgroup {
    public $sys;
    public $base;
    public $root = "";
    public $ok = false;

    public func __construct($sys, $base) {
        $this->sys = $sys;
        $this->base = $base;
    }

    # $slice: nazwa katalogu głównego grup zenitd, np. "zenit.slice"
    public func init($slice, $isPid1) {
        $sys = $this->sys;
        if (!$sys->exists($this->base . "/cgroup.controllers")) { return false; }
        $own = "";
        if (!$isPid1) {
            $cg = $sys->readFile("/proc/self/cgroup", 4096);
            if ($cg != null) {
                foreach (split($cg, "\n") as $l) {
                    if (starts_with($l, "0::")) { $own = substr($l, 3, strlen($l) - 3); }
                }
            }
            if ($own == "/") { $own = ""; }
        }
        $parent = $this->base . $own;
        if ($own != "") {
            # proces menedżera musi opuścić węzeł, w którym tworzymy dzieci (reguła „no internal processes”)
            $leaf = $parent . "/zenitd.leaf";
            if ($sys->mkdirp($leaf, 493) >= 0) {
                $sys->writeFile($leaf . "/cgroup.procs", strval($sys->pid()), false);
            }
        }
        $root = $parent . "/" . $slice;
        if ($sys->mkdirp($root, 493) < 0) { return false; }
        $sys->writeFile($parent . "/cgroup.subtree_control", "+memory +cpu +pids +io", false);
        $sys->writeFile($root . "/cgroup.subtree_control", "+memory +cpu +pids +io", false);
        $this->root = $root;
        $this->ok = true;
        return true;
    }

    public func create($name) {
        if (!$this->ok) { return ""; }
        $p = $this->root . "/" . $name;
        if ($this->sys->mkdirp($p, 493) < 0) { return ""; }
        return $p;
    }

    public func pids($path) {
        $out = [];
        if ($path == "") { return $out; }
        $t = $this->sys->readFile($path . "/cgroup.procs", 1048576);
        if ($t == null) { return $out; }
        foreach (split($t, "\n") as $l) {
            $n = util.parseInt($l, -1);
            if ($n > 0) { $out[] = $n; }
        }
        return $out;
    }

    public func empty($path) { return count($this->pids($path)) == 0; }

    public func kill($path, $sig) {
        if ($path == "") { return 0; }
        if ($sig == 9 && $this->sys->exists($path . "/cgroup.kill")) {
            $this->sys->writeFile($path . "/cgroup.kill", "1", false);
            return 0;
        }
        $n = 0;
        foreach ($this->pids($path) as $p) {
            if ($p != $this->sys->pid()) { $this->sys->kill($p, $sig); $n += 1; }
        }
        return $n;
    }

    public func remove($path) {
        if ($path == "") { return 0; }
        return $this->sys->rmdir($path);
    }

    func setFile($path, $file, $value) {
        return $this->sys->writeFile($path . "/" . $file, $value, false);
    }

    # limity z sekcji [Service]
    public func applyLimits($path, $u) {
        if ($path == "") { return []; }
        $warn = [];
        $v = $u->get("Service", "MemoryMax", null);
        if ($v != null) { $this->setFile($path, "memory.max", $this->sizeValue($v)); }
        $v = $u->get("Service", "MemoryHigh", null);
        if ($v != null) { $this->setFile($path, "memory.high", $this->sizeValue($v)); }
        $v = $u->get("Service", "MemorySwapMax", null);
        if ($v != null) { $this->setFile($path, "memory.swap.max", $this->sizeValue($v)); }
        $v = $u->get("Service", "MemoryMin", null);
        if ($v != null) { $this->setFile($path, "memory.min", $this->sizeValue($v)); }
        $v = $u->get("Service", "TasksMax", null);
        if ($v != null) {
            if ($v == "infinity") { $this->setFile($path, "pids.max", "max"); }
            else { $this->setFile($path, "pids.max", strval(util.parseInt($v, 0))); }
        }
        $v = $u->get("Service", "CPUWeight", null);
        if ($v != null && $v != "idle") { $this->setFile($path, "cpu.weight", strval(util.parseInt($v, 100))); }
        $v = $u->get("Service", "IOWeight", null);
        if ($v != null) { $this->setFile($path, "io.weight", "default " . strval(util.parseInt($v, 100))); }
        $v = $u->get("Service", "CPUQuota", null);
        if ($v != null && ends_with($v, "%")) {
            $pct = util.parseInt(substr($v, 0, strlen($v) - 1), 0);
            if ($pct > 0) { $this->setFile($path, "cpu.max", strval($pct * 1000) . " 100000"); }
        }
        return $warn;
    }

    func sizeValue($v) {
        $n = util.parseSize($v);
        if ($n == null) {
            # procent pamięci fizycznej
            if (ends_with($v, "%")) {
                $pct = util.parseInt(substr($v, 0, strlen($v) - 1), 0);
                $mi = $this->sys->readFile("/proc/meminfo", 8192);
                if ($mi != null && $pct > 0) {
                    foreach (split($mi, "\n") as $l) {
                        if (starts_with($l, "MemTotal:")) {
                            $kb = util.parseInt(trim(replace(replace(substr($l, 9, strlen($l) - 9), "kB", ""), " ", "")), 0);
                            return strval(intval($kb * 1024 * $pct / 100));
                        }
                    }
                }
            }
            return "max";
        }
        if ($n < 0) { return "max"; }
        return strval($n);
    }

    public func memoryCurrent($path) {
        if ($path == "") { return -1; }
        $t = $this->sys->readFile($path . "/memory.current", 64);
        if ($t == null) { return -1; }
        return util.parseInt(trim($t), -1);
    }
}
